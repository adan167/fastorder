{
  "name": "mi-entregble2",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve fastorder-client",
    "start:client": "ng serve fastorder-client --port 4203",
    "start:kitchen": "ng serve fastorder-kitchen --port 4201",
    "start:admin": "ng serve fastorder-admin --port 4202",
    "build": "ng build fastorder-client",
    "build:client": "ng build fastorder-client",
    "build:kitchen": "ng build fastorder-kitchen",
    "build:admin": "ng build fastorder-admin",
    "build:all": "pnpm run build:client && pnpm run build:kitchen && pnpm run build:admin",
    "watch": "ng build fastorder-client --watch --configuration development"
  },
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "dependencies": {
    "@angular/common": "^22.2.0",
